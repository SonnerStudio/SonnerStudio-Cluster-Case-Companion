<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GPU-Speicherfreigabe nach jedem Neustart (LaunchDaemon, braucht Admin-Rechte zur Installation). -->
<plist version="1.0"><dict>
  <key>Label</key><string>de.sonnerstudio.wiredlimit</string>
  <key>ProgramArguments</key><array><string>/usr/sbin/sysctl</string><string>-w</string><string>iogpu.wired_limit_mb=__WIRED_MB__</string></array>
  <key>RunAtLoad</key><true/>
</dict></plist>
